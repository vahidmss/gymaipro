# Copy to .env in project root (never commit .env)
# Run:  copy .env.example .env

SUPABASE_URL=https://api.gymaipro.ir
SUPABASE_ANON_KEY=

OPENAI_USE_PROXY=false
OPENAI_API_KEY=

OTP_USE_SERVER=true
SUPABASE_EDGE_FUNCTIONS_ENABLED=true
AI_ENGINE_MODE=openai
COACH_V2_ENABLED=true

# Server-side SMS provider names. Keep real values only in local .env/server env.
SMS_API_BASE_URL=https://rest.payamak-panel.com/api/SendSMS/BaseServiceNumber
SMS_API_USERNAME=
SMS_API_PASSWORD=
SMS_API_BODY_ID=
SMS_BODY_ID_TRAINER_PROGRAM_REQUEST=
SMS_BODY_ID_USER_PROGRAM_PURCHASE=
# Required only after creating the crash-alert pattern template.
SMS_BODY_ID_CRASH_ALERT=
OPS_ALERT_PHONE=

ONLINE_PAYMENT_ENABLED=true
WORDPRESS_API_BASE_URL=https://gymaipro.ir
